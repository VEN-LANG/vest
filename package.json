{
  "name": "lara-node",
  "version": "0.1.0",
  "private": true,
  "description": "Lara-Node — a Laravel-inspired Node.js framework powered by Vite+",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --filter './packages/*' dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint packages apps",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "format": "oxfmt packages/ apps",
    "format:check": "oxfmt --check packages apps",
    "clean": "pnpm -r --filter './packages/*' clean",
    "create-lara-node": "node packages/create-lara-node/dist/index.js",
    "docs:dev": "pnpm -r --filter './packages/docs' docs:dev",
    "docs:build": "pnpm -r --filter './packages/docs' docs:build"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.47.0",
    "oxlint": "^0.16.12",
    "rimraf": "^6.1.3",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

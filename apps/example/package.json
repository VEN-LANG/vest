{
  "name": "example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --expose-gc -r @swc-node/register -r tsconfig-paths/register -r ./src/register.ts src/server.ts",
    "start": "node dist/server.js",
    "build": "tsdown src/server.ts src/artisan.ts --format cjs --out-dir dist",
    "artisan": "node --expose-gc -r @swc-node/register -r tsconfig-paths/register -r ./src/register.ts src/artisan.ts",
    "migrate": "node --expose-gc -r @swc-node/register -r tsconfig-paths/register -r ./src/register.ts src/artisan.ts migrate",
    "migrate:fresh": "node --expose-gc -r @swc-node/register -r tsconfig-paths/register -r ./src/register.ts src/artisan.ts migrate:fresh",
    "db:seed": "node --expose-gc -r @swc-node/register -r tsconfig-paths/register -r ./src/register.ts src/artisan.ts db:seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lara-node/auth": "workspace:^",
    "@lara-node/cache": "workspace:^",
    "@lara-node/console": "workspace:^",
    "@lara-node/core": "workspace:^",
    "@lara-node/csv": "workspace:^",
    "@lara-node/db": "workspace:^",
    "@lara-node/events": "workspace:^",
    "@lara-node/excel": "workspace:^",
    "@lara-node/horizon": "workspace:^",
    "@lara-node/mail": "workspace:^",
    "@lara-node/middlewares": "workspace:^",
    "@lara-node/pdf": "workspace:^",
    "@lara-node/queue": "workspace:^",
    "@lara-node/router": "workspace:^",
    "@lara-node/telescope": "workspace:^",
    "@lara-node/validator": "workspace:^",
    "@lara-node/xml": "workspace:^",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.4",
    "reflect-metadata": "^0.2.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.40",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.12.4",
    "@types/yargs": "^17.0.35",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

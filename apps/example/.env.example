APP_NAME=apps/example
APP_ENV=local
APP_KEY=
APP_DEBUG=true
PORT=3000

# ── Database ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_NAME=apps/example
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_POOL_LIMIT=10
# DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock  # use instead of host/port on Linux
# SKIP_DB=1  # set to skip DB init in test/CI

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# ── Cache / Queue / Mail / Broadcast ─────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=apps/example
BROADCAST_DRIVER=null
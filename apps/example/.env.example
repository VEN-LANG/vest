APP_NAME=apps/example
APP_ENV=local
APP_KEY=
APP_DEBUG=true
PORT=3000

# ── Database ──────────────────────────────────────────────────
DB_CONNECTION=mongodb
DB_NAME=apps/example
# MONGO_URI=mongodb://user:pass@localhost:27017/apps/example?authSource=admin
DB_HOST=127.0.0.1
DB_PORT=27017
# MONGO_REPLICA_SET=rs0
# MONGO_DIRECT_CONNECTION=true
# MONGO_RETRY_WRITES=false
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# SKIP_DB=1  # set to skip DB init in test/CI

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# ── Cache / Queue / Mail / Broadcast ─────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=apps/example
BROADCAST_DRIVER=null
{
  "name": "@lara-node/router",
  "version": "0.2.20",
  "description": "Lara-Node Express router builder, middleware stack, and OpenAPI generator",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lara-node/cache": "workspace:^",
    "@lara-node/console": "workspace:^",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@lara-node/core": "workspace:^",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "rimraf": "^6.1.3",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@lara-node/core": "workspace:^",
    "@lara-node/db": "workspace:^"
  }
}

{
  "name": "@lara-node/db",
  "version": "0.1.30",
  "description": "Lara-Node ORM — Eloquent-style models, migrations, schema builder",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lara-node/console": "workspace:^",
    "mongodb": "^7.2.0",
    "mysql2": "^3.22.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@lara-node/core": "workspace:^",
    "@types/node": "^24.12.4",
    "@types/yargs": "^17.0.35",
    "rimraf": "^6.1.3",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@lara-node/core": "workspace:^"
  }
}

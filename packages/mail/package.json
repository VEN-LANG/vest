{
  "name": "@lara-node/mail",
  "version": "0.1.10",
  "description": "Lara-Node mail manager with SMTP, log, and array drivers",
  "files": [
    "dist",
    "config",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lara-node/events": "workspace:^",
    "@lara-node/queue": "workspace:^",
    "nodemailer": "^8.0.9"
  },
  "devDependencies": {
    "@lara-node/core": "workspace:^",
    "@types/node": "^24.12.4",
    "@types/nodemailer": "^7.0.11",
    "rimraf": "^6.1.3",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@lara-node/core": "workspace:^"
  },
  "laraNode": {
    "publish": [
      {
        "tag": "config",
        "from": "config/mail.config.ts",
        "to": "config/mail.config.ts"
      }
    ]
  }
}

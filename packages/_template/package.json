{
  "name": "@lara-node/example",
  "version": "0.0.0",
  "private": true,
  "description": "Skeleton for a new @lara-node package — copy this directory, rename, and remove \"private\".",
  "keywords": [
    "lara-node",
    "laravel"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lara-node/core": "workspace:^"
  },
  "devDependencies": {
    "@lara-node/core": "workspace:^",
    "@types/node": "^24.12.4",
    "rimraf": "^6.1.3",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
